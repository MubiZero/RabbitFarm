<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Ссылка-приглашение https://rabbitfarm.click/i открывается самим
	     приложением, а не Safari. Домен обязан отдавать
	     /.well-known/apple-app-site-association с нашим Team ID; пока не
	     отдаёт, ссылка открывает страницу в браузере. Прежний домен
	     оставлен для приглашений, разосланных до переезда. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:rabbitfarm.click</string>
		<string>applinks:rabbitfarm.mubi.dev</string>
	</array>
</dict>
</plist>
