# Шаблон окружения. Скопируйте в backend/.env и подставьте свои значения.
# Настоящий .env в git не попадает — см. .gitignore.

# Server
NODE_ENV=development
PORT=4567
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=rabbitfarm
DB_USER=rabbitfarm_user
# Пароли и секреты сгенерируйте, например: openssl rand -base64 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Отдельная база для интеграционных тестов.
DB_TEST_NAME=rabbitfarm_test

# JWT. Секреты — не менее 32 символов, разные для access и refresh.
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Upload. Тип проверяется по содержимому файла, а не по заголовку из запроса,
# поэтому сюда имеет смысл вписывать только форматы, известные серверу:
# image/jpeg, image/jpg, image/png, image/webp, application/pdf. Остальное
# (в том числе image/svg+xml — он запрещён в коде) будет отброшено.
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Хранилище загруженных файлов — MinIO (S3-совместимое). Не опционально,
# как Firebase ниже: без него не работает загрузка фото. Для локального
# docker compose эндпоинт и порт не трогать — там уже указан адрес
# контейнера minio, см. docker-compose.yml.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rabbitfarm-uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Регистрация. Каждая успешная регистрация заводит НОВУЮ ферму и её
# владельца — сервис многоарендный, ферм много. Работника заводит не
# регистрация, а приглашение по коду (см. staffService.acceptInvitation).
# false закрывает публичную регистрацию совсем — например, когда фермы
# заводятся вручную или через отдельный процесс.
ALLOW_REGISTRATION=false

# CORS: список адресов веб-клиента через запятую. Мобильные приложения
# ходят без заголовка Origin и под это ограничение не попадают.
# Значение * разрешает запросы с любого сайта — в продакшене так не надо.
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info

# Firebase Cloud Messaging (push-уведомления). Необязательно: без этих трёх
# значений сервис стартует как обычно, просто ничего не отправляет.
# Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Эсхата Мерчант (оплата подписки). Опционально, как Firebase выше — без
# этих значений создать заказ на оплату нельзя, но сервис стартует.
# BaseUrl у тестового и боевого контуров разный. HashKey — секрет подписи,
# наружу не отдавать никогда.
ESKHATA_BASE_URL=
ESKHATA_COMPANY_ID=
ESKHATA_HASH_KEY=
ESKHATA_MERCHANT_ID=

# Payom SMS (gateway.payom.tj). Опционально — без токена/шаблонов SMS
# просто не уходят. templateId заводится в кабинете payom и меняется при
# любой правке текста шаблона — держать в конфиге, не в коде.
SMS_BASE_URL=https://gateway.payom.tj
SMS_API_TOKEN=
SMS_SENDER_NAME=
SMS_TIMEOUT_SECONDS=15
# JSON-карта «ключ уведомления → templateId», например:
# {"user.verification_code":"df83ca2e-1405-45db-9762-f9398c529fe4"}
SMS_TEMPLATE_IDS={}

# Почта (сброс пароля). Опционально, как Payom SMS выше — без этих значений
# письмо просто не уходит. SMTP через собственный почтовый сервер (Stalwart).
# Порт 465 (implicit TLS) — у нас 587 (STARTTLS) блокируется файрволом
# хостинга, живьём не отвечает (см. docs/HANDOFF.md).
SMTP_HOST=mail.mubi.dev
SMTP_PORT=465
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=rabbitfarm@mubi.dev
SMTP_FROM_NAME=RabbitFarm
