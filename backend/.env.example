# Шаблон окружения. Скопируйте в backend/.env и подставьте свои значения.
# Настоящий .env в git не попадает — см. .gitignore.

# Server
NODE_ENV=development
PORT=4567
API_VERSION=v1

# Database
DB_HOST=localhost
DB_PORT=3307
DB_NAME=rabbitfarm
DB_USER=rabbitfarm_user
# Пароли и секреты сгенерируйте, например: openssl rand -base64 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Отдельная база для интеграционных тестов.
DB_TEST_NAME=rabbitfarm_test

# JWT. Секреты — не менее 32 символов, разные для access и refresh.
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,image/webp

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Регистрация. Первый зарегистрировавшийся поднимает ферму и становится
# владельцем; дальше публичная регистрация закрыта. Поставьте true, только
# пока заводите дополнительную учётку — новые пользователи получат роль worker.
ALLOW_REGISTRATION=false

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info
