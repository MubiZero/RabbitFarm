{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_|^next$",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-var": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": [
        "migrations/**/*.js",
        "seeders/**/*.js"
      ],
      "rules": {
        "no-unused-vars": [
          "error",
          {
            "args": "none"
          }
        ],
        "no-console": "off"
      }
    },
    {
      "files": [
        "tests/**/*.js"
      ],
      "env": {
        "jest": true
      }
    }
  ]
}
